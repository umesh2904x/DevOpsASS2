{
  "name": "bookstore",
  "version": "1.0.0",
  "description": "Bookstore - end-to-end DevOps pipeline (Agile + Git + CI/CD + monitoring)",
  "main": "server/src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/src/server.js",
    "lint": "node scripts/lint.js",
    "test": "node --test \"server/tests/**/*.test.js\"",
    "coverage": "c8 node --test \"server/tests/**/*.test.js\"",
    "build": "node scripts/build.js",
    "verify": "npm run lint && npm run coverage && npm run build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "supertest": "^7.0.0"
  }
}
